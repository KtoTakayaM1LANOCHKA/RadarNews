# Copy to .env for local development. Set these as variables/secrets in Amvera.
DEMO_MODE=1
DEMO_OTP=1
ADMIN_PHONE=+79999999999
EDITOR_PASSWORD=change-this-before-deployment

# Bot and automatic search start inside uvicorn by default.
TELEGRAM_BOT_TOKEN=
# Optional: filled automatically by getMe when the bot starts.
TELEGRAM_BOT_USERNAME=
NEWSRADAR_PUBLIC_URL=https://radar-trigger.msk1.amvera.tech
NEWS_WORKER_ENABLED=1

# Optional search/AI. Google News RSS works without a search API key.
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External integrations only; built-in Telegram does not need INGEST_SECRET.
INGEST_SECRET=
MAX_WEBHOOK_SECRET=
VK_WEBHOOK_SECRET=
VK_CONFIRMATION_CODE=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional local data paths (Amvera automatically uses /data).
# DB_PATH=/data/newsradar.db
# UPLOAD_DIR=/data/uploads
