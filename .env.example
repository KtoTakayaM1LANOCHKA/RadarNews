# This is a local demo. Never expose demo credentials or OTPs publicly.
DEMO_MODE=1
DEMO_OTP=1
EDITOR_PASSWORD=change-this-before-deployment
# Номер, который входит как администратор (смените перед публичным запуском)
ADMIN_PHONE=+79999999999
DB_PATH=./newsradar.db
UPLOAD_DIR=./uploads
# Optional bot integrations (do not commit tokens)
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
BRAVE_SEARCH_API_KEY=

# Browser-visible key for Yandex Maps JavaScript API 3.0 (restrict HTTP Referer)
YANDEX_MAPS_API_KEY=
